# VulcanFlow local development environment — architecture §A6.1, §A6.2.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is the template and the documentation; it
# holds no secret, because nothing here is one: every credential below is a
# deliberately obvious local placeholder, and §A7 invariant 11 makes the
# adapters they unlock refuse to start under VF_ENV=production.
#
# Two audiences read this file. `docker compose` substitutes the VF_*_IMAGE,
# VF_PG_*, VF_S3_* and VF_*_PORT variables into docker-compose.yml; the Rust
# binaries read the VF_* configuration variables through figment (task A1).
# Where one value serves both, it is defined once here.

# ===========================================================================
# Environment
# ===========================================================================

# dev | staging | production. The binaries refuse the fake, memory and dev
# adapters below when this is `production` (§A6.1, §A7 invariant 11), and that
# refusal is tested. Nothing in this file is appropriate for any value but
# `dev`.
VF_ENV=dev

RUST_LOG=info,vf_api=debug,vf_operator=debug,vf_ingest=debug,sqlx=warn

# ===========================================================================
# Image pins
#
# Pinned here rather than in docker-compose.yml so that changing a pin is a
# one-line edit in an untracked file, and so the whole pinned set is readable
# in one place.
#
# NOT YET CONFIRMED AGAINST A REGISTRY. These tags were chosen from each
# project's published tagging scheme, but the machine this file was written on
# has no container runtime and no registry access, so none of them has been
# pulled. The first `just dev-up` on a developer machine is what confirms
# them; correct a tag here and report it on VFL-12 so the default follows.
# Digest pinning (`image@sha256:...`) is the end state for reproducibility and
# wants one `docker buildx imagetools inspect` per image on a machine that can
# reach the registry.
# ===========================================================================

VF_POSTGRES_IMAGE=pgvector/pgvector:pg17
VF_PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.24.1-p1
VF_RUSTFS_IMAGE=rustfs/rustfs:latest
VF_VALKEY_IMAGE=valkey/valkey:8-alpine
VF_MINIO_IMAGE=minio/minio:latest
VF_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
VF_MAILPIT_IMAGE=axllent/mailpit:v1.21

# ===========================================================================
# Postgres
# ===========================================================================

VF_PG_DATABASE=vulcanflow
VF_PG_USER=vulcanflow
VF_PG_PASSWORD=vulcanflow
VF_PG_PORT=5432
VF_PGBOUNCER_PORT=6432

# The pooled URL: through PgBouncer in transaction pooling mode. This is what
# the services use, because it is what Aether's CNPG cluster looks like.
#
# `statement-cache-capacity=0` is not optional and not a workaround. In
# transaction pooling PgBouncer hands a server connection to the next
# transaction, so a statement sqlx prepared on one connection may not exist on
# the next; with a client-side cache the second use fails. The alternative is
# PgBouncer's own `max_prepared_statements`, and docker-compose.yml
# deliberately leaves that at 0 so the client side has to be correct rather
# than rescued by a pooler setting the real cluster may not have. The T4
# pooled-connection tests are what prove this.
VF_DATABASE_URL=postgres://vulcanflow:vulcanflow@127.0.0.1:6432/vulcanflow?statement-cache-capacity=0

# The direct URL: straight to Postgres, bypassing the pooler. Migrations,
# session-scoped state (`SET`, `LISTEN`, temp tables) and any assertion about
# what the server itself did. `vf-testkit::TestDb` hands out a pool on each.
VF_DATABASE_URL_DIRECT=postgres://vulcanflow:vulcanflow@127.0.0.1:5432/vulcanflow

# sqlx-cli reads DATABASE_URL and nothing else, and both of the things it does
# here — applying migrations and refreshing the offline query data in `.sqlx/`
# — are DDL and introspection that must not go through a transaction pooler.
# So it points at the direct URL.
DATABASE_URL=postgres://vulcanflow:vulcanflow@127.0.0.1:5432/vulcanflow

# ===========================================================================
# Object storage — the ArtifactStore port (§A6.1)
# ===========================================================================

# s3 | fs | memory. Refused as `fs` or `memory` under VF_ENV=production.
VF_ARTIFACT_STORE=s3

VF_S3_ACCESS_KEY=vulcanflow
VF_S3_SECRET_KEY=vulcanflow
VF_S3_PORT=9000
VF_MINIO_PORT=9100

VF_S3_ENDPOINT=http://127.0.0.1:9000
VF_S3_REGION=us-east-1
VF_S3_BUCKET=vf-artifacts

# Path-style addressing: the bucket is in the path, not in the hostname.
# Virtual-hosted style would need wildcard DNS for every bucket, which no
# local stand-in and no Ceph RGW deployment here provides. §A5 makes this an
# explicit setting of the object_store adapter rather than something inferred
# from the endpoint, so it is explicit here too.
VF_S3_PATH_STYLE=true

# Run the S3 conformance suite against the second implementation:
#   docker compose --profile minio up -d minio
#   VF_S3_ENDPOINT=http://127.0.0.1:9100 cargo test -p vf-db --features integration
# The F2 acceptance criteria require it to pass against both.

# ===========================================================================
# Wake bus — the WakeBus port (§A6.1)
# ===========================================================================

# redis | inprocess. Refused as `inprocess` under VF_ENV=production.
VF_WAKE_BUS=redis

VF_VALKEY_PORT=6379
VF_REDIS_URL=redis://127.0.0.1:6379

# ===========================================================================
# Scan execution — the ScanRuntime port (§A6.1)
# ===========================================================================

# kube | fake. `fake` is the only value that works without a cluster, and it
# is refused under VF_ENV=production. `just run-local` passes
# `--runtime fake` explicitly rather than relying on this.
VF_SCAN_RUNTIME=fake

# ===========================================================================
# Identity — the TokenVerifier port (§A6.1, §A6.4)
# ===========================================================================

# jwks | dev. `dev` is the local issuer of §A6.4 and is refused under
# VF_ENV=production.
VF_AUTH=dev

VF_OIDC_ISSUER=https://dev-issuer.vulcanflow.test/realms/vulcanflow
VF_OIDC_AUDIENCE=vf-api

# Optional: a PKCS#8 PEM private key for the dev issuer, if you want to sign
# with your own rather than the deterministic fixture key that
# `vf_testkit::identity::DevIssuer::fixture()` derives.
#
# Set the *variable name* you keep the key in, never the key itself — not
# here, not in `.env`, not anywhere in the repository. Leave it unset to use
# the fixture key.
# VF_DEV_ISSUER_KEY_VAR=VF_DEV_ISSUER_KEY_PEM

# The keycloak profile, if you want the real PKCE flow instead (§A6.4). It is
# documented and required by no recipe and no task.
#   docker compose --profile keycloak up -d keycloak
#   # then: VF_AUTH=jwks, and point VF_OIDC_ISSUER at the realm below
VF_KEYCLOAK_PORT=8080
VF_KEYCLOAK_ADMIN=admin
VF_KEYCLOAK_PASSWORD=admin
# VF_OIDC_ISSUER=http://127.0.0.1:8080/realms/vulcanflow

# ===========================================================================
# Mail — the Mailer port (M4, no task yet)
# ===========================================================================

VF_MAILPIT_SMTP_PORT=1025
VF_MAILPIT_UI_PORT=8025
# VF_SMTP_URL=smtp://127.0.0.1:1025

# ===========================================================================
# Local service ports
# ===========================================================================

VF_API_ADDR=127.0.0.1:8000
VF_INGEST_ADDR=127.0.0.1:8001
VF_OPERATOR_METRICS_ADDR=127.0.0.1:9464

# Shared secret for the vf-hook-notify → vf-ingest HMAC notification contract
# (§A3.6). A local placeholder; the real one is per-tenant and comes from the
# work record, never from configuration.
VF_NOTIFY_HMAC_KEY=local-development-only-not-a-secret
