# Pinned CI tool versions.
#
# ADR-0002 §3 pins the crates the workspace *builds against*. It does not pin the
# cargo subcommands CI *runs*, and an unpinned `cargo install` is a supply-chain
# hole in the gate that exists to close supply-chain holes. These are pinned here
# and installed with `--locked` so the tool's own lockfile is used.
#
# Recorded in ADR-0002 §3.7.6, which is the decision; this file is the
# machine-readable copy that CI reads.

CARGO_DENY_VERSION=0.20.2
CARGO_AUDIT_VERSION=0.22.2
# CycloneDX SBOM generator (§21.3 "generates an SBOM per image").
CARGO_CYCLONEDX_VERSION=0.5.9
# Embeds the dependency list in the shipped binary so an SBOM can be recovered
# from the artifact itself, not only from the build that produced it.
CARGO_AUDITABLE_VERSION=0.7.6

# The target that ships. Aether is arm64 (TDD §24, ADR-0002 §2); do not assume an
# x86 base image.
AETHER_TARGET=aarch64-unknown-linux-gnu
# The browser target for vf-graph (TDD §7.3, §14.1).
WASM_TARGET=wasm32-unknown-unknown
